<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="TaskHarness.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F4F3F1"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E6E4E0"/>
    <SolidColorBrush x:Key="InkBrush" Color="#2A2724"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#7A756E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6B3FA0"/>
    <SolidColorBrush x:Key="AccentWashBrush" Color="#EDE9F5"/>
    <SolidColorBrush x:Key="SolidBrush" Color="#241F1C"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
    </Style>
    <Style x:Key="ToolbarButton" TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Setter Property="Background" Value="{StaticResource SolidBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource SolidBrush}"/>
    </Style>
    <Style x:Key="RailButton" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentWashBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
