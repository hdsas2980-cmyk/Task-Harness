<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaskHarness.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1320" Height="860" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}">
  <Window.InputBindings>
    <KeyBinding Key="L" Command="{Binding LoadCommand}"/>
    <KeyBinding Key="R" Command="{Binding RefreshCommand}"/>
  </Window.InputBindings>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0" Margin="16">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="长任务看板"/>
        <TextBlock Margin="0,4,0,16" Foreground="{StaticResource MutedBrush}" Text="{Binding ProjectPath}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="键盘"/>
        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" Text="载入 / 刷新   L  R"/>
        <TextBlock Foreground="{StaticResource MutedBrush}" Text="搜索框点一下后输入"/>
      </StackPanel>
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="任务视图"/>
        <ScrollViewer Margin="0,8,0,12" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Filters}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource RailButton}" Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" Text="{Binding Title}"/>
                      <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Hint}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" Text="{Binding Count}"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </DockPanel>

    <DockPanel Grid.Column="1" Margin="0,12,16,12">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock FontWeight="SemiBold" FontSize="14" Text="{Binding ProjectName}"/>
          <TextBlock Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" Text="{Binding ProjectRev}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBox Width="220" Margin="0,0,8,0" VerticalContentAlignment="Center" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索编号、描述、验证命令"/>
          <Button Style="{StaticResource PrimaryButton}" Content="载入任务  L" Command="{Binding LoadCommand}"/>
          <Button Style="{StaticResource ToolbarButton}" Content="刷新任务  R" Command="{Binding RefreshCommand}"/>
        </StackPanel>
      </Grid>

      <StatusBar DockPanel.Dock="Bottom" Background="Transparent" Margin="0,8,0,0">
        <StatusBarItem>
          <TextBlock Text="{Binding StatusText}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StatusBarItem>
        <StatusBarItem HorizontalAlignment="Right">
          <TextBlock Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="11" Text="{Binding SourceHint}"/>
        </StatusBarItem>
      </StatusBar>

      <TabControl SelectedIndex="{Binding TabIndex}">
        <TabItem Header="下一步看板">
          <ScrollViewer Padding="18">
            <StackPanel>
              <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="下一步看板"/>
              <TextBlock Margin="0,8,0,0" FontSize="28" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding HeroId}"/>
              <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding HeroDesc}" TextWrapping="Wrap"/>
              <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding HeroMeta}"/>
              <DockPanel Margin="0,16,0,0">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="验证命令"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="复制" Command="{Binding CopyVerifyCommand}"/>
                <TextBox Margin="12,0" IsReadOnly="True" FontFamily="Consolas" Text="{Binding HeroCmd, Mode=OneWay}"/>
              </DockPanel>
              <StackPanel Margin="0,18,0,0" Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding MapWhere}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,8,0,0" Text="{Binding MapNext}" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Margin="0,24,0,8" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="当前行"/>
              <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/>
              <TextBlock Margin="0,24,0,8" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="最近证据与评审"/>
              <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Kind}"/>
                        <TextBlock FontFamily="Consolas" Text="{Binding Task}"/>
                        <TextBlock Text="{Binding Detail}"/>
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="{Binding Ts}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="任务列表">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="12">
              <ComboBox DockPanel.Dock="Right" Width="140" SelectedItem="{Binding SortBy}" ItemsSource="{Binding SortOptions}"/>
              <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding CountAll, StringFormat=全部 {0} 条}"/>
            </DockPanel>
            <ListBox ItemsSource="{Binding Rows}" SelectedIndex="{Binding SelectedIndex}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Margin="8,4" Padding="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="88"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock FontFamily="Consolas" FontWeight="SemiBold" Text="{Binding Task.Id}"/>
                      <StackPanel Grid.Column="1" Margin="12,0">
                        <TextBlock Text="{Binding Task.DisplayDesc}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Deps}"/>
                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Gate}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding StatusLabel}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
        <TabItem Header="进度时间线">
          <ListBox ItemsSource="{Binding Rows}" SelectedIndex="{Binding SelectedIndex}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="12,8">
                  <TextBlock Width="120" FontFamily="Consolas" Text="{Binding Task.Id}"/>
                  <TextBlock DockPanel.Dock="Right" Width="80" Text="{Binding StatusLabel}"/>
                  <ProgressBar Height="10" Minimum="0" Maximum="100" Value="{Binding Fill}"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="进度日志">
          <TextBox Margin="12" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Text="{Binding Progress, Mode=OneWay}"/>
        </TabItem>
      </TabControl>
    </DockPanel>
  </Grid>
</Window>
