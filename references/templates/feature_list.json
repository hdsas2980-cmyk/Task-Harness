{
  "schema_version": "2.0",
  "harness_version": "2.0.0",
  "project": "{{project name}}",
  "description": "{{project goal and scope}}",
  "revision": 1,
  "baseline": {
    "created_at": "{{ISO-8601}}",
    "created_by": {
      "actor_id": "{{actor}}",
      "session_id": "{{session}}"
    },
    "source_revision": "sha256:{{64 hex source or workspace fingerprint}}"
  },
  "verification_policy": {
    "zero_tests": "fail",
    "require_independent_review": true,
    "require_current_definition_revision": true
  },
  "features": [
    {
      "id": "feat-01",
      "category": "foundation",
      "priority": 1,
      "description": "Implement the first independently verifiable capability",
      "status": "ready",
      "passes": false,
      "definition_revision": 1,
      "depends_on": [],
      "scope": {
        "include": ["The exact behavior owned by this task"],
        "exclude": ["Adjacent behavior owned elsewhere"]
      },
      "targets": [
        {
          "path": "src/existing-module.ts",
          "role": "implementation",
          "responsibility": "Extend the existing implementation; do not create a parallel subsystem",
          "required": false
        },
        {
          "path": "tests/existing-module.test.ts",
          "role": "test",
          "responsibility": "Prove the acceptance criteria and regression invariants",
          "required": false
        }
      ],
      "steps": [
        {
          "id": "step-01",
          "action": "Inspect the existing implementation and its callers before editing",
          "expected_result": "The change reuses the established ownership boundary"
        },
        {
          "id": "step-02",
          "action": "Implement the smallest compatible change",
          "expected_result": "All acceptance criteria are observable"
        }
      ],
      "acceptance_criteria": [
        {
          "id": "ac-01",
          "description": "The requested behavior is covered by an automated test"
        },
        {
          "id": "ac-02",
          "description": "The affected package regression suite passes"
        }
      ],
      "verification": {
        "checks": [
          {
            "id": "target-test",
            "kind": "test",
            "command": ["npm", "test", "--", "tests/existing-module.test.ts"],
            "cwd": ".",
            "timeout_seconds": 120,
            "criterion_ids": ["ac-01"],
            "minimum_tests_discovered": 1,
            "required_variants": [
              {
                "name": "default",
                "build_tags": [],
                "features": []
              }
            ]
          },
          {
            "id": "package-regression",
            "kind": "test",
            "command": ["npm", "test"],
            "cwd": ".",
            "timeout_seconds": 600,
            "criterion_ids": ["ac-02"],
            "minimum_tests_discovered": 1,
            "required_variants": [
              {
                "name": "default",
                "build_tags": [],
                "features": []
              }
            ]
          }
        ]
      },
      "reuse": {
        "extends": ["src/existing-module.ts"],
        "forbid_parallel": ["A second implementation of the same responsibility"],
        "fingerprint": "foundation:existing-module:requested-behavior",
        "decision": "extend_existing"
      },
      "evidence": [],
      "reviews": [],
      "amendments": []
    }
  ]
}
