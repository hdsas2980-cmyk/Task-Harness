{
  "schema_version": "2.0",
  "project": "{{project name}}",
  "created": "{{YYYY-MM-DD}}",
  "updated": "{{YYYY-MM-DD}}",
  "description": "{{project description}}",
  "harness": {
    "version": "2.0.0",
    "manifest": "feature_list.json",
    "progress_log": "progress.txt",
    "control_directory": ".task-harness",
    "validator": ".task-harness/scripts/validate_harness.py"
  },
  "authorization": {
    "local_edits": "confirm from current user request and permission mode",
    "install_dependencies": "requires current authorization",
    "commit": "requires current authorization",
    "push": "requires current authorization and verified remote",
    "production": "requires explicit authorization for the specific operation"
  },
  "policy": {
    "features_per_session": 1,
    "independent_review_required": true,
    "zero_tests": "fail",
    "definition_changes": "approved amendment only",
    "prefer_existing_modules": true
  },
  "prerequisites": [
    {
      "id": "toolchain",
      "description": "Required toolchain versions match project declarations",
      "on_failure": "blocked"
    },
    {
      "id": "source-baseline",
      "description": "The source revision and working tree are recorded before implementation",
      "on_failure": "blocked"
    }
  ],
  "milestones": [
    {
      "name": "{{milestone}}",
      "feature_ids": ["feat-01"]
    }
  ]
}
